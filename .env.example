# OTP backend base URL
# Choose one that matches your environment

# Production (release builds require HTTPS)
# EXPO_PUBLIC_AUTH_API_BASE_URL=https://api.example.com

# Android emulator (development)
EXPO_PUBLIC_AUTH_API_BASE_URL=http://10.0.2.2:3000

# Optional development-only bypass when /auth/session/refresh is not ready.
# Never enable this for production.
# EXPO_PUBLIC_AUTH_DEV_BYPASS_REFRESH=true

# iOS simulator (development)
# EXPO_PUBLIC_AUTH_API_BASE_URL=http://localhost:3000

# Real device (development, same Wi-Fi as backend machine)
# EXPO_PUBLIC_AUTH_API_BASE_URL=http://192.168.1.10:3000
