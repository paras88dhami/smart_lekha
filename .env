# OTP backend base URL
# Android emulator -> backend running on your PC (development)
EXPO_PUBLIC_AUTH_API_BASE_URL=http://10.0.2.2:3000
EXPO_PUBLIC_AUTH_DEV_BYPASS_REFRESH=true

# Mock auth backend controls (development)
# Set to true if you want to test new-user create-profile flow with any valid NP/IN number.
MOCK_ALLOW_NEW_USERS=true

# Production (release builds require HTTPS):
# EXPO_PUBLIC_AUTH_API_BASE_URL=https://api.example.com

# Real device on same Wi-Fi (development example):
# EXPO_PUBLIC_AUTH_API_BASE_URL=http://192.168.1.10:3000
